<!--Likhang Maharlika Collection-->
<div class="lm-collection">
    <h1>The Likhang Maharlika Collection</h1>
    <p>Likhang Maharlika Collection is a unique fashion brand dedicated to bridging cultural gaps and fostering mutual respect through casual couture.</p>
    <p>We celebrate the rich heritage of the Filipino Muslim community by integrating traditional details into modern clothing.</p>
    <p>Our collection includes high-quality Muslim garments such as hijabs and traditional attire, as well as casual clothing infused with Muslim cultural accents.</p>
</div>

<div class="lm-ribbon"><i>Sa Bawat Hibla, May Istorya</i></div>

<!--Likhang Maharlika Collection--> 
<div class="lm-collage">
    <div class="lm-collage-column">
        <img src="images/lm_col2.jpeg" alt="Likhang Maharlika - Image">
        <img src="images/lm_col3.jpeg" alt="Likhang Maharlika - Image">
    </div>
    <div class="lm-collage-column">
        <img src="images/lm_col4.jpeg" alt="Likhang Maharlika - Image">
        <img src="images/lm_col1.jpeg" alt="Likhang Maharlika - Image">
    </div>
    <div class="lm-collage-column">
        <img src="images/lm_col5.jpeg" alt="Likhang Maharlika - Image">
        <img src="images/lm_col6.jpeg" alt="Likhang Maharlika - Image">
    </div>    
</div>

<div class="lm-collection-container">
    <div class="lm-collection-column">
        <img src="images/lm_5_1.png">
        <h1>Traditional<br>Muslim Wear</h1>
        <p>Handcrafted abayas, hijabs, and dresses designed with intricate Filipino Muslim accents</p>
    </div>

    <div class="lm-collection-column">
        <img src="images/lm_6_1.png">
        <h1>Culturally Inspired<br>Casual Wear</h1>
        <p>Modern clothing featuring traditional Filipino Muslim details, perfect for everyday wear while honoring
            Filipino Muslim artistry</p>
    </div>

    <div class="lm-collection-column">
        <img src="images/lm_7_1.png">
        <h1>Sustainable<br>Fashion</h1>
        <p>Using upcycled materials and eco-friendly practices to create garments and accessories</p>
    </div>
</div>

<!--Our Products-->
<div class="container-products-lm">
    <h1>Our Products</h1>
    <div class="container-products-main-lm">
        {{#each products}}
        <div class="card card-lm-products">
            <img src="{{this.image}}" class="card-img-top" alt="{{this.image}}">
            <div class="card-body">
                <div class="card-info">
                    <h5 class="card-title">{{this.title}}</h5>
                </div>
                <p class="card-text">{{this.description}}</p>
            </div>
        </div>
        {{/each}}
    </div>
      <button id="viewMoreBtn" class="btn btn-success mt-4">View More</button>
</div>

<!--The Women Behind Likhang Maharlika-->
<div class="container-officers-lm">
    <h1>The Women Behind Likhang Maharlika</h1>
    <div class="container-officers-main-lm">
        <div class="officer-scroll-lm">
        {{#each officers}}
        <div class="officer-card">
            <img src="{{this.image}}" alt="{{this.image_alt}}">
            <h3>{{this.name}}</h3>
            <h5>{{this.position}}</h5>
        </div>
        {{/each}}
        </div>
    </div>
</div>

