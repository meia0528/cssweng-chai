<div class="container-products-lm">
    <h1>Our Products</h1>
    <div class="container-products-main-lm">
        {{#each products}}
        <div class="card card-lm-products">
            <img src="{{this.image}}" class="card-img-top" alt="{{this.image}}">
            <div class="card-body">
                <div class="card-info">
                    <h5 class="card-title">{{this.title}}</h5>
                    <p class="card-price">Php {{this.price}}</p>
                </div>
                <p class="card-text">{{this.description}}</p>
            </div>
        </div>
        {{/each}}
    </div>
      <button id="viewMoreBtn" class="btn btn-success mt-4">View More</button>
</div>

<!--The Women Behind Likhang Maharlika-->
<div class="container-officers-lm">
    <h1>The Women Behind Likhang Maharlika</h1>
    <div class="container-officers-main-lm">
        <div class="officer-scroll-lm">
        {{#each officers}}
        <div class="officer-card">
            <img src="{{this.image}}" alt="{{this.image_alt}}">
            <h3>{{this.name}}</h3>
            <h5>{{this.position}}</h5>
        </div>
        {{/each}}
        </div>
    </div>
</div>

