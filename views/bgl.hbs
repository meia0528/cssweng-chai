<!--Main & Description-->
<div class="container-bgl-main">
    <h1>Batang Gift of Love</h1>
   <p>
        <span data-i18n="bgl-main-desc-part1">
            Batang Gift of Love is a children and youth-centered organization dedicated to fostering unity and compassion among communities. We strive to bridge the existing gap between the rich and poor through our meaningful initiatives and programs. We aim to empower the youth to become instruments of kindness, hope, and positive change in society. 
        </span>
        <br><br>
        <span data-i18n="bgl-main-desc-part2">
            Through Batang Gift of Love, we want to ensure that
        </span>
        <strong><em data-i18n="bgl-main-desc-part3"> no child is left behind. </em></strong>
    </p>

    <div class="bgl-image-desc">
        <div>
            <img src="images/bgl_main_landing.jpeg" alt="BGL Image">
        </div>
        <div class="bgl-image-desc-text">
            <h3>Bridging the Gap... Breaking the Wall</h3>
            <p data-i18n="bgl-image-desc-part1">Bridging the gap between rich and poor means ensuring that no one is left behind while others move ahead.</p>
            <br>
            <p data-i18n="bgl-image-desc-part2">Breaking the wall between Muslims and non-Muslims means opening hearts and minds through dialogue and shared experiences.</p>
        </div>
    </div>

</div>

<!--History of BGL-->
<div class="container-history-bgl">
    <h1 data-i18n="bgl-history-title">Our History</h1>
</div>

<!--Upcoming Events-->
<div class="container-upcoming-bgl">
    <h1>
        <span data-i18n="upcoming-events-line1">Upcoming</span><br>
        <span data-i18n="upcoming-events-line2">Events</span>
    </h1>

    <div class="container-upcoming-main-bgl">
        <div class="upcoming-scroll-bgl">
        {{#if upcomingEvents.length}}
        {{#each upcomingEvents}}
            <div class="card card-bgl-events" id="upcoming-bgl">
                <img src="{{this.image}}" class="card-img-top" alt="{{this.image}}">
                <div class="card-body">
                    <h5 class="card-title">{{this.title}}</h5>
                    <div class="card-info">
                        <p class="card-date"><i class="bi bi-calendar-fill"></i> {{this.date}}</p>
                    </div>
                    <p class="card-text">{{this.description}}</p>
                </div>
            </div>
        {{/each}}
        {{else}}
            <p style="padding: 40px;">No upcoming events at the moment.</p>
        {{/if}}
        </div>
    </div>
</div>

<!--Our Past Events-->
<div class="container-events-bgl">
    <h1 data-i18n="bgl-past-events">Our Past Events</h1>
    <div class="container-events-main-bgl">
        {{#each pastEvents}}
        <div class="card card-bgl-events" id = "past-events">
            <img src="{{this.image}}" class="card-img-top" alt="{{this.image}}">
            <div class="card-body">
                <h5 class="card-title">{{this.title}}</h5>
                <div class="card-info">
                    <p class="card-beneficiary">Batang Gift of Love</p>
                    <p class="card-date"><i class="bi bi-calendar-fill"></i> {{this.date}}</p>
                </div>
                <p class="card-text">{{this.description}}</p>
            </div>
        </div>
        {{/each}}
    </div>
      <button id="viewMoreBtn" class="btn btn-success mt-4">View More</button>

</div>

