<!--Main & Description-->
<div class="container-bgl-main">
    <h1>Batang Gift of Love</h1>
    <p>Batang Gift of Love is a children and youth-centered organization dedicated to fostering unity and compassion among communities. We strive to bridge the existing gap between the rich and poor through our meaningful initiatives and programs. We aim to empower the youth to become instruments of kindness, hope, and positive change in society. <br> <br> Through Batang Gift of Love, we want to ensure that<strong><em> no child is left behind. </em></strong> </p>
    <div class="bgl-image-desc">
        <img src="images/bgl_main_landing.png" alt ="Batang Gift of Love Main">
    </div>
</div>

<!--History of BGL-->
<div class="container-history-bgl">
    <h1>Our History</h1>
</div>

<!--Upcoming Events-->
<div class="container-upcoming-bgl">
    <h1>Upcoming<br>Events</h1>
    <div class="container-upcoming-main-bgl">
        <div class="upcoming-scroll-bgl">
        {{#if upcomingEvents.length}}
        {{#each upcomingEvents}}
            <div class="card card-bgl-events" id="upcoming-bgl">
                <img src="{{this.image}}" class="card-img-top" alt="{{this.image}}">
                <div class="card-body">
                    <h5 class="card-title">{{this.title}}</h5>
                    <div class="card-info">
                        <p class="card-date"><i class="bi bi-calendar-fill"></i> {{this.date}}</p>
                    </div>
                    <p class="card-text">{{this.description}}</p>
                </div>
            </div>
        {{/each}}
        {{else}}
            <p style="padding: 40px;">No upcoming events at the moment.</p>
        {{/if}}
        </div>
    </div>
</div>

<!--Our Past Events-->
<div class="container-events-bgl">
    <h1>Our Past Events</h1>
    <div class="container-events-main-bgl">
        {{#each pastEvents}}
        <div class="card card-bgl-events" id = "past-events">
            <img src="{{this.image}}" class="card-img-top" alt="{{this.image}}">
            <div class="card-body">
                <h5 class="card-title">{{this.title}}</h5>
                <div class="card-info">
                    <p class="card-beneficiary">Batang Gift of Love</p>
                    <p class="card-date"><i class="bi bi-calendar-fill"></i> {{this.date}}</p>
                </div>
                <p class="card-text">{{this.description}}</p>
            </div>
        </div>
        {{/each}}
    </div>
      <button id="viewMoreBtn" class="btn btn-success mt-4">View More</button>

</div>

