<!--Gift Global Mission Vision-->
<div class="gg-title">
    <h1>Gift Global</h1>
</div>

<div class="gg-mission-vision">
  <div class="gg-mission">
    <h2 data-i18n="gg-mission-title">Mission</h2>
    <p data-i18n="gg-mission-body">To transform the lives of the most vulnerable children by meeting their physical, spiritual, educational, and psychosocial needs through various programs.</p>
  </div>

  <div class="divider"></div>

<div class="gg-vision">
    <h2 data-i18n="gg-vision-title">Vision</h2>
    <p data-i18n="gg-vision-body">To see gift global children experience and create healthy lives and relationships, positively impact their community, and sustain themselves through proper education and the development of life skills.</p>
  </div>
</div>

<!--Our Initiatives-->
<div class="gg-initiatives">
    <h1 data-i18n="gg-initiatives-title">Our Initiatives</h1>

    <div class="gg-initiatives-row">
        <div class="gg-initiatives-column">
            <img class="gg-initiatives-pic" src="images/gg_4.png">
        </div>
        <div class="gg-initiatives-column">
            <div class="gg-initiatives-row">
                <img src="images/gg_8_1.png">
                <h1>Nursery</h1>
            </div>
            <div class="gg-initiatives-row">
                <img src="images/gg_9_1.png">
                <h1>Feeding Program</h1>
            </div>
        </div>
    </div>
</div>

<!--Our Past Events-->
<div class="container-events-gg">
    <h1 data-i18n="gg-past-events">Our Past Events</h1>
    <div class="container-events-main-gg">
        {{#each events}}
        <div class="card card-gg-events">
            <img src="{{this.image}}" class="card-img-top" alt="{{this.image}}">
            <div class="card-body">
                <h5 class="card-title">{{this.title}}</h5>
                <div class="card-info">
                    <p class="card-beneficiary">Gift Global</p>
                    <p class="card-date"><i class="bi bi-calendar-fill"></i> {{this.date}}</p>
                </div>
                <p class="card-text">{{this.description}}</p>
            </div>
        </div>
        {{/each}}
    </div>
      <button id="viewMoreBtn" class="btn btn-success mt-4">View More</button>
</div>

<!--Footer-->
<div class="footer">
    <div class="footer-left">
        <p>Taguig Community Hope <br> Alternative Incorporated</p>
        <a href="/about-us"> About Us</a>
        <a href="#"> Back to Top</a>
    </div>

    <img src="images/chai_footerlogo.png" alt="CHAI-Taguig Footer Logo">

    <div class="footer-right">
        <div class="footer-fb">
            <i class="bi bi-facebook"></i>
            <a href="https://www.facebook.com/share/16DkCEtRb1/">FOLLOW CHAI TAGUIG<br>ON FACEBOOK</a>
        </div>
        <button class="btn btn-success">DONATE NOW!</button>
    </div>
</div>

<script src="/language.js"></script>

<script>
document.addEventListener("DOMContentLoaded", () => {
  const viewMoreBtn = document.getElementById("viewMoreBtn");
  const container = document.querySelector(".container-events-gg");
  const cards = [...document.querySelectorAll(".card-gg-events")];

  cards.forEach((card, index) => {
    if (index < 6) {
      card.classList.add("visible");
    }
  });

  viewMoreBtn.addEventListener("click", () => {
    cards.forEach(card => card.classList.add("visible"));
    container.classList.add("expanded");
    viewMoreBtn.style.display = "none";
  });
});
</script>

