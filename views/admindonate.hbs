<div class="admindonate-body">
  <img src="/images/logo.png" alt="Logo">

  <div class="admindonate-container">
    <div class="admindonate-edit">
      <h1><i class="bi bi-pencil-square"></i>Edit Contact Details</h1>

      <form action="/admin/donate-edit" method="POST" class="admin-form">
        <div class="form-group admindonate-edit-form">
          <label for="name">Contact Name</label>
          <input type="text" id="name" name="name" value="{{donateInfo.name}}" required>
        </div>

        <div class="form-group admindonate-edit-form">
          <label for="contactNo">Contact Number</label>
          <input type="text" id="contactNo" name="contactNo" value="{{donateInfo.contactNo}}" required>
        </div>

        <button type="button" class="admindonate-edit-cancel" onclick="window.location='/centralhub'">Cancel</button>
        <button type="submit" class="btn-submit admindonate-edit-save"><i class="bi bi-floppy2-fill"></i> Save</button>
      </form>
    </div>
    

  </div>
</div>

<script>
   const url = new URLSearchParams(window.location.search);
   if (url.get('updated') === 'true'){
    alert('Contact details have been updated successfully!');
    window.location.href = '/centralhub';
   }
</script>